<?xml version="1.0" encoding="utf-8"?>
<!-- Live rate or current offer. Refreshes rates at most every 30 minutes on its own, or when you tap refresh. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_rate_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="220dp"
    android:previewLayout="@layout/widget_rate"
    android:previewImage="@drawable/brand_mark"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
