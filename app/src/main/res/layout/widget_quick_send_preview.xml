<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Quick Send widget, with sample people. Not used for real data. -->
<!-- Widgets are drawn with RemoteViews, so: android:tint (app:tint needs AppCompat), empty FrameLayouts as
     flexible space (Space isn't allowed), nested frames for the avatar and flag, and no compound drawables. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UselessLeaf,UselessParent,UseCompoundDrawables"
        android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="1"
            android:text="@string/widget_available_balance"
            android:textColor="@color/widget_slate"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/brand_mark" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_sample_balance"
        android:textColor="@color/widget_ink"
        android:textSize="28sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/outfit_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="@string/widget_send_again_caps"
        android:textColor="@color/widget_slate"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_send_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/widget_accent" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_send"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_1"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF1F5130"
                    android:text="@string/widget_sample_initials_1"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_sample_name_1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_3"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF134F86"
                    android:text="@string/widget_sample_initials_2"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_sample_name_2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_2"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF7A3A0C"
                    android:text="@string/widget_sample_initials_3"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_sample_name_3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_5"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF8A1E33"
                    android:text="@string/widget_sample_initials_4"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_sample_name_4"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="3"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:maxLines="3"
            android:textColor="@color/widget_slate"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
