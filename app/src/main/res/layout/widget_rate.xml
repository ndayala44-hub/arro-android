<?xml version="1.0" encoding="utf-8"?>
<!-- Live rate or current offer, 2 x 2 and narrower. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rate_pair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:text="@string/widget_sample_pair"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rate_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_live"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/widget_badge_live"
            android:textColor="@color/widget_ink"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/rate_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_icon_button"
            android:contentDescription="@string/widget_refresh"
            android:padding="5dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_ink" />
    </LinearLayout>
    <TextView
        android:id="@+id/rate_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_sample_rate"
        android:textColor="@color/widget_ink"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/rate_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_regular"
        android:maxLines="1"
        android:text="@string/widget_sample_unit"
        android:textColor="@color/widget_slate"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/rate_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_regular"
        android:maxLines="1"
        android:text="@string/widget_sample_status"
        android:textColor="@color/widget_slate"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/rate_status_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_medium"
        android:maxLines="1"
        android:textColor="@color/widget_warn"
        android:textSize="11sp"
        android:visibility="gone" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="4dp" />

    <LinearLayout
        android:id="@+id/rate_button"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/rate_button_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/rate_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:text="@string/widget_lock_rate"
            android:textColor="@color/widget_on_primary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
