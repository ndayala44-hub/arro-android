<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Send: available balance and one-tap "send again" to the people you send to most. -->
<!-- Widgets are drawn with RemoteViews, so: android:tint (app:tint needs AppCompat), empty FrameLayouts as
     flexible space (Space isn't allowed), nested frames for the avatar and flag, and no compound drawables. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UselessLeaf,UselessParent,UseCompoundDrawables"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/qs_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qs_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="1"
            android:text="@string/widget_available_balance"
            android:textColor="@color/widget_slate"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/brand_mark" />
    </LinearLayout>

    <TextView
        android:id="@+id/qs_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_sample_balance"
        android:textColor="@color/widget_ink"
        android:textSize="30sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="4dp" />

    <TextView
        android:id="@+id/qs_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/outfit_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="@string/widget_send_again_caps"
        android:textColor="@color/widget_slate"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/qs_send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_send_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/widget_accent" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/qs_send_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_send"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qs_r1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/qs_r1_initials"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_1"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF1F5130"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/qs_r1_flag"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/qs_r1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qs_r2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/qs_r2_initials"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_1"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF1F5130"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/qs_r2_flag"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/qs_r2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qs_r3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/qs_r3_initials"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_1"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF1F5130"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/qs_r3_flag"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/qs_r3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qs_r4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/qs_r4_initials"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/widget_avatar_1"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FF1F5130"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/qs_r4_flag"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/widget_flag_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/qs_r4_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/qs_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="3"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:maxLines="3"
            android:textColor="@color/widget_slate"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
