<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Arro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/arro_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Arro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/arro_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Arro</item>
    </style>
</resources>
