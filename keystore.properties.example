# Copy this file to keystore.properties (git-ignored) and fill in your upload key to sign release builds.
# Create a key with:  keytool -genkeypair -v -keystore arro-release.jks -alias arro -keyalg RSA -keysize 4096 -validity 10000
storeFile=arro-release.jks
storePassword=CHANGE_ME
keyAlias=arro
keyPassword=CHANGE_ME
